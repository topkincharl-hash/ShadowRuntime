{
  "name": "@hustlenation/queenzoe",
  "version": "2.0.0",
  "type": "module",
  "description": "QueenZoe Sovereign Executive Intelligence — Long-lived multi-agent orchestration cognition system",
  "author": "HustleNation",
  "license": "MIT",

  "homepage": "https://queenzoe.ai",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/hustlenation/queenzoe.git"
  },

  "keywords": [
    "queenzoe",
    "hustlenation",
    "ai",
    "agentic-ai",
    "langgraph",
    "executive-ai",
    "multi-agent",
    "orchestration",
    "memory",
    "automation",
    "voice-ai",
    "cognitive-system",
    "sovereign-ai",
    "apk",
    "pwa"
  ],

  "bin": {
    "queenzoe": "./queenzoe.mjs",
    "queenzoe-server": "./bin/queenzoe-server.mjs",
    "hustlenation": "./bin/hustlenation.mjs"
  },

  "main": "src/lib/index.mjs",

  "module": "src/lib/index.mjs",

  "types": "src/lib/interfaces.d.ts",

  "sideEffects": false,

  "exports": {
    ".": {
      "types": "./src/lib/interfaces.d.ts",
      "import": "./src/lib/index.mjs",
      "default": "./src/lib/index.mjs"
    },

    "./cli": "./queenzoe.mjs",

    "./lib": {
      "types": "./src/lib/interfaces.d.ts",
      "import": "./src/lib/index.mjs",
      "default": "./src/lib/index.mjs"
    },

    "./kernel": {
      "import": "./src/kernel/executive-kernel.mjs",
      "default": "./src/kernel/executive-kernel.mjs"
    },

    "./agents": {
      "import": "./src/agents/index.mjs",
      "default": "./src/agents/index.mjs"
    },

    "./memory": {
      "import": "./src/memory/index.mjs",
      "default": "./src/memory/index.mjs"
    },

    "./voice": {
      "import": "./src/voice/index.mjs",
      "default": "./src/voice/index.mjs"
    },

    "./server": {
      "import": "./src/server/server.mjs",
      "default": "./src/server/server.mjs"
    },

    "./plugins": {
      "import": "./src/plugins/index.mjs",
      "default": "./src/plugins/index.mjs"
    },

    "./types": "./src/types/shared.mjs",

    "./package.json": "./package.json"
  },

  "typesVersions": {
    "*": {
      ".": [
        "src/lib/interfaces.d.ts"
      ],

      "lib": [
        "src/lib/interfaces.d.ts"
      ],

      "agents": [
        "src/lib/interfaces.d.ts"
      ],

      "memory": [
        "src/lib/interfaces.d.ts"
      ]
    }
  },

  "files": [
    "queenzoe.mjs",

    "bin/",

    "src/**/*.mjs",

    "src/**/*.d.ts",

    "!src/**/__tests__/**",

    "!src/**/*.test.*",

    "!src/**/*.spec.*",

    "src/lib/README.md",

    "plugins/**/*.mjs",

    "plugins/**/*.json",

    "plugins/**/*.jsx",

    "!plugins/**/node_modules/**",

    "themes.json",

    ".env.example",

    "README.md",

    "LICENSE"
  ],

  "scripts": {
    "start": "node queenzoe.mjs",

    "start:server": "node queenzoe.mjs --server",

    "start:queen": "node src/kernel/executive-kernel.mjs",

    "start:runtime": "node src/runtime/runtime-manager.mjs",

    "start:heartbeat": "node src/runtime/heartbeat.mjs",

    "serve": "node src/server/server.mjs",

    "build:ui": "cd ui && pnpm install && pnpm run build",

    "dev:ui": "cd ui && pnpm run dev",

    "build:all": "pnpm install && pnpm run build:ui",

    "dev": "concurrently \"pnpm run start:server\" \"pnpm run dev:ui\"",

    "tray": "cd tray-app && npx electron .",

    "tray:dev": "cd tray-app && npx electron . --dev",

    "tray:install": "cd tray-app && npm install",

    "tray:build:mac": "cd tray-app && npx electron-builder --mac",

    "tray:build:win": "cd tray-app && npx electron-builder --win",

    "apk:sync": "npx cap sync",

    "apk:android": "npx cap open android",

    "pwa:build": "vite build",

    "memory:index": "node src/memory/indexer.mjs",

    "memory:clean": "node src/memory/cleanup.mjs",

    "agents:start": "node src/agents/launcher.mjs",

    "reflection:run": "node src/reflection/reflection-engine.mjs",

    "heartbeat:run": "node src/runtime/heartbeat.mjs",

    "vector:sync": "node src/vector/sync.mjs",

    "voice:start": "node src/voice/realtime-voice.mjs",

    "test": "vitest run",

    "test:watch": "vitest",

    "lint": "eslint .",

    "format": "prettier --write .",

    "postinstall": "pnpm run install:skills",

    "install:skills": "node scripts/install-skills.mjs"
  },

  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",

    "@capacitor/android": "^7.4.2",

    "@capacitor/app": "^7.0.2",

    "@capacitor/core": "^7.4.2",

    "@capacitor/haptics": "^7.0.2",

    "@capacitor/keyboard": "^7.0.2",

    "@capacitor/push-notifications": "^7.0.2",

    "@capacitor/splash-screen": "^7.0.2",

    "@capacitor/status-bar": "^7.0.2",

    "@google/genai": "^1.41.0",

    "@langchain/community": "^0.3.55",

    "@langchain/core": "^0.3.75",

    "@langchain/langgraph": "^0.2.74",

    "@langchain/openai": "^0.6.12",

    "@mlc-ai/web-llm": "^0.2.81",

    "@modelcontextprotocol/sdk": "^1.26.0",

    "@qdrant/js-client-rest": "^1.15.0",

    "@radix-ui/react-dialog": "^1.1.15",

    "@radix-ui/react-dropdown-menu": "^2.1.16",

    "@radix-ui/react-tooltip": "^1.2.8",

    "@supabase/supabase-js": "^2.76.1",

    "@tanstack/react-query": "^5.90.3",

    "axios": "^1.12.2",

    "body-parser": "^2.2.2",

    "chalk": "^5.5.0",

    "cheerio": "^1.1.2",

    "chokidar": "^5.0.0",

    "clsx": "^2.1.1",

    "concurrently": "^9.2.1",

    "dotenv": "^17.3.1",

    "express": "^5.1.0",

    "framer-motion": "^12.23.24",

    "langchain": "^0.3.36",

    "lucide-react": "^0.542.0",

    "mathjs": "^14.7.0",

    "node-cron": "^4.2.1",

    "node-llama-cpp": "^3.18.1",

    "node-pty": "^1.1.0",

    "openai": "^5.20.2",

    "ora": "^8.2.0",

    "pdf-parse": "^1.1.1",

    "puppeteer": "^24.22.3",

    "qdrant-client": "^1.14.0",

    "react": "^19.1.1",

    "react-dom": "^19.1.1",

    "react-router-dom": "^7.8.2",

    "recharts": "^3.1.2",

    "sharp": "^0.34.3",

    "socket.io": "^4.8.1",

    "socket.io-client": "^4.8.1",

    "tailwind-merge": "^3.3.1",

    "uuid": "^11.1.0",

    "vite-plugin-pwa": "^1.0.3",

    "vm2": "^3.10.4",

    "ws": "^8.18.3",

    "zod": "^3.25.76"
  },

  "optionalDependencies": {
    "@bubblelab/bubble-core": "^0.1.229",

    "@bubblelab/bubble-runtime": "^0.1.229",

    "@bubblelab/shared-schemas": "^0.1.229"
  },

  "engines": {
    "node": ">=20.0.0"
  },

  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "node-pty",
      "protobufjs",
      "puppeteer",
      "sharp"
    ]
  },

  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",

    "@testing-library/react": "^16.3.0",

    "@types/node": "^24.3.1",

    "@types/react": "^19.1.12",

    "@types/react-dom": "^19.1.9",

    "@vitejs/plugin-react": "^5.0.2",

    "autoprefixer": "^10.4.21",

    "eslint": "^9.35.0",

    "eslint-config-prettier": "^10.1.8",

    "eslint-plugin-react": "^7.37.5",

    "postcss": "^8.5.6",

    "prettier": "^3.6.2",

    "tailwindcss": "^4.1.13",

    "typescript": "^5.9.2",

    "vite": "^7.1.5",

    "vitest": "^3.2.4"
  }
}